@import "tailwindcss";

:root {
  --ivory: #fff9ef;
  --cream: #f5ead9;
  --sand: #e7d5bd;
  --espresso: #291912;
  --brown: #5e4337;
  --muted: #887166;
  --coral: #e95e3c;
  --ember: #c8442b;
  --amber: #f1a141;
  --sage: #7d8f72;
  --ink: #263038;
  --line: rgba(55, 31, 21, .14);
  --serif: Georgia, "Times New Roman", serif;
  --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--ivory); }
body { margin: 0; background: var(--ivory); color: var(--espresso); font-family: var(--sans); font-size: 15px; line-height: 1.55; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
img { display: block; max-width: 100%; }
::selection { background: var(--coral); color: #fff; }

.test-ribbon { min-height: 30px; padding: 6px 4vw; display: flex; justify-content: center; gap: 28px; background: var(--espresso); color: #fff8ec; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
.test-ribbon span + span { color: #f6b49e; }
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 249, 239, .94); border-bottom: 1px solid var(--line); backdrop-filter: blur(20px); }
.header-inner { height: 82px; max-width: 1540px; margin: auto; padding: 0 4vw; display: grid; grid-template-columns: 270px 1fr 270px; align-items: center; }
.brand-lockup { display: inline-flex; align-items: center; gap: 10px; width: fit-content; }
.brand-lockup img { width: 48px; height: 48px; }
.brand-lockup span { display: flex; flex-direction: column; }
.brand-lockup strong { font-family: var(--serif); font-size: 24px; letter-spacing: .18em; line-height: 1; }
.brand-lockup small { margin-top: 5px; color: var(--muted); font-size: 9px; letter-spacing: .06em; }
.site-header nav { display: flex; align-items: center; justify-content: center; gap: 34px; font-size: 13px; font-weight: 650; }
.site-header nav a { position: relative; padding: 30px 0; }
.site-header nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: 20px; height: 2px; background: var(--coral); transition: right .2s ease; }
.site-header nav a:hover::after { right: 0; }
.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 19px; }
.header-action { position: relative; display: flex; flex-direction: column; align-items: center; gap: 1px; border: 0; background: transparent; cursor: pointer; font-size: 19px; line-height: 1; }
.header-action span { font-size: 9px; font-weight: 750; text-transform: uppercase; letter-spacing: .08em; }
.header-action b { position: absolute; right: -8px; top: -8px; display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 20px; background: var(--coral); color: white; font-size: 10px; }
.mobile-menu { display: none; }
.search-bar { max-width: 1540px; margin: auto; padding: 18px 4vw 24px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 18px; border-top: 1px solid var(--line); }
.search-bar label { font-family: var(--serif); font-size: 22px; }
.search-bar input { width: 100%; padding: 13px 0; border: 0; border-bottom: 1px solid var(--espresso); background: transparent; outline: none; }
.search-bar button { border: 0; padding: 12px 22px; background: var(--espresso); color: white; cursor: pointer; }

.hero { position: relative; min-height: min(760px, calc(100vh - 112px)); overflow: hidden; background: #ad7a4f; }
.hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(34, 17, 11, .76) 0%, rgba(34, 17, 11, .48) 35%, rgba(34, 17, 11, .05) 65%); }
.hero-copy { position: relative; z-index: 1; width: min(680px, 48vw); padding: clamp(100px, 12vh, 145px) 0 90px 7vw; color: white; }
.eyebrow { display: inline-block; color: var(--coral); font-size: 11px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
.eyebrow.light { color: #ffc7ad; }
.hero h1 { margin: 22px 0 25px; font-family: var(--serif); font-size: clamp(58px, 6.2vw, 104px); font-weight: 400; line-height: .94; letter-spacing: -.045em; }
.hero h1 em { color: #ffbd92; font-weight: 400; }
.hero-copy > p { max-width: 540px; margin: 0 0 34px; color: rgba(255,255,255,.83); font-size: 17px; line-height: 1.75; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.button { min-height: 48px; padding: 14px 25px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; cursor: pointer; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; transition: transform .2s ease, background .2s ease; }
.button:hover { transform: translateY(-2px); }
.button.primary { background: var(--coral); color: white; }
.button.primary:hover { background: var(--ember); }
.button.glass { border-color: rgba(255,255,255,.45); background: rgba(255,255,255,.1); color: white; backdrop-filter: blur(10px); }
.button.espresso { background: var(--espresso); color: white; }
.button.quiet { border-color: var(--line); background: transparent; }
.button.wide { width: 100%; }
.hero-note { position: absolute; z-index: 1; right: 4vw; bottom: 35px; width: 270px; padding: 18px 20px; border: 1px solid rgba(255,255,255,.35); background: rgba(41,25,18,.58); color: #fff; backdrop-filter: blur(10px); }
.hero-note strong, .hero-note span { display: block; }
.hero-note strong { font-family: var(--serif); font-size: 20px; }
.hero-note span { margin-top: 3px; color: rgba(255,255,255,.72); font-size: 11px; }

.trust-row { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); background: #fffdf7; }
.trust-row > div { min-height: 95px; padding: 23px 3vw; display: flex; align-items: center; gap: 14px; border-right: 1px solid var(--line); }
.trust-row > div:last-child { border-right: 0; }
.trust-row b { color: var(--coral); font-family: var(--serif); font-size: 22px; font-weight: 400; }
.trust-row span { display: flex; flex-direction: column; }
.trust-row strong { font-size: 12px; }
.trust-row small { margin-top: 2px; color: var(--muted); font-size: 10px; }

.section { max-width: 1540px; margin: auto; padding: 105px 4vw; }
.section-head { margin-bottom: 40px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
.section-head h2 { margin: 10px 0 0; font-family: var(--serif); font-size: clamp(38px, 4vw, 62px); font-weight: 400; line-height: 1.05; letter-spacing: -.035em; }
.text-link { border-bottom: 1px solid currentColor; padding-bottom: 4px; color: var(--brown); font-size: 12px; font-weight: 750; }
.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.category-tile { position: relative; min-height: 310px; padding: 24px; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; background: var(--espresso); color: white; box-shadow: 0 18px 38px rgba(41,25,18,.08); }
.category-tile::after { content: ""; position: absolute; z-index: 2; inset: 0; border: 1px solid rgba(255,255,255,.22); pointer-events: none; transition: border-color .3s, background .3s; }
.category-tile:hover::after { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.03); }
.category-image { position: absolute; z-index: -3; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .65s cubic-bezier(.2,.8,.2,1), filter .4s; }
.category-tile:hover .category-image { transform: scale(1.045); filter: saturate(1.05); }
.category-overlay { position: absolute; z-index: -2; inset: 0; background: linear-gradient(180deg, rgba(35,19,13,.05) 10%, rgba(35,19,13,.12) 42%, rgba(35,19,13,.88) 100%); transition: opacity .3s; }
.category-number { position: absolute; z-index: 1; left: 18px; top: 18px; min-width: 35px; height: 35px; padding: 0 9px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(33,18,13,.42); color: rgba(255,255,255,.92); font-family: var(--serif); font-size: 12px; backdrop-filter: blur(8px); }
.category-copy { position: relative; z-index: 1; padding-right: 35px; }
.category-tile h3 { max-width: 240px; margin: 0 0 8px; font-family: var(--serif); font-size: 25px; font-weight: 400; line-height: 1.05; text-shadow: 0 2px 18px rgba(0,0,0,.28); }
.category-tile p { max-width: 230px; margin: 0; color: rgba(255,255,255,.72); font-size: 10px; line-height: 1.45; }
.category-tile i { position: absolute; z-index: 1; right: 20px; bottom: 20px; width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(33,18,13,.28); font-size: 17px; font-style: normal; backdrop-filter: blur(8px); transition: transform .3s, background .3s; }
.category-tile:hover i { transform: translate(2px,-2px); background: var(--coral); }

.product-section { padding-top: 65px; }
.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 38px 18px; }
.product-card { min-width: 0; }
.product-image-wrap { position: relative; display: block; aspect-ratio: 1 / 1.08; overflow: hidden; background: var(--cream); }
.product-image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s cubic-bezier(.2,.8,.2,1); }
.product-card:hover .product-image-wrap img { transform: scale(1.035); }
.product-badge, .discount-badge { position: absolute; top: 12px; z-index: 1; padding: 7px 9px; font-size: 9px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
.product-badge { left: 12px; background: var(--espresso); color: white; }
.discount-badge { right: 12px; background: var(--coral); color: white; }
.product-card-body { padding: 16px 2px 0; }
.product-category { color: var(--muted); font-size: 9px; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
.product-card h3 { min-height: 42px; margin: 7px 0 8px; font-family: var(--serif); font-size: 19px; font-weight: 400; line-height: 1.18; }
.rating { display: flex; align-items: center; gap: 7px; }
.rating span, .stars { color: var(--amber); font-size: 12px; letter-spacing: .05em; }
.rating small { color: var(--muted); font-size: 10px; }
.rating.unrated span { color: var(--coral); font-size: 9px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
.price-row { margin-top: 9px; display: flex; align-items: baseline; gap: 9px; }
.price-row strong { font-size: 16px; }
.price-row s { color: var(--muted); font-size: 11px; }
.quick-add { width: 100%; margin-top: 14px; padding: 11px 0; display: flex; justify-content: space-between; border: 0; border-top: 1px solid var(--line); background: transparent; cursor: pointer; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.quick-add span { color: var(--coral); font-size: 16px; }

.editorial-banner { position: relative; min-height: 570px; padding: 90px 8vw; display: grid; grid-template-columns: minmax(220px, .7fr) 1.2fr .8fr; align-items: center; gap: 60px; overflow: hidden; background: var(--espresso); color: white; }
.editorial-banner::before { content: ""; position: absolute; inset: 0; opacity: .18; background: radial-gradient(circle at 20% 50%, var(--coral), transparent 35%), radial-gradient(circle at 86% 20%, var(--amber), transparent 25%); }
.editorial-banner > * { position: relative; z-index: 1; }
.editorial-mark { aspect-ratio: 1; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: #fff4df; }
.editorial-mark img { width: 62%; }
.editorial-banner h2 { margin: 16px 0 22px; font-family: var(--serif); font-size: clamp(48px, 5vw, 76px); font-weight: 400; line-height: 1; letter-spacing: -.035em; }
.editorial-banner h2 em { color: #ffae86; font-weight: 400; }
.editorial-banner p { max-width: 620px; margin: 0 0 29px; color: rgba(255,255,255,.68); }
.editorial-banner blockquote { margin: 0; align-self: end; padding: 0 0 10px 25px; border-left: 1px solid rgba(255,255,255,.3); color: #f4be9f; font-family: var(--serif); font-size: 27px; font-style: italic; }

.review-section { padding-bottom: 120px; }
.test-chip { padding: 8px 11px; border: 1px solid #d69d7b; color: #a34c31; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.review-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.review-grid article { min-height: 320px; padding: 38px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fffdf8; }
.review-grid h3 { margin: 28px 0 14px; font-family: var(--serif); font-size: 27px; font-weight: 400; }
.review-grid p { color: var(--brown); font-family: var(--serif); font-size: 19px; line-height: 1.55; }
.review-grid footer { margin-top: 28px; display: flex; flex-direction: column; }
.review-grid footer b { font-size: 11px; }.review-grid footer span { color: var(--muted); font-size: 9px; text-transform: uppercase; }
.closing-cta { min-height: 430px; padding: 90px 5vw; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: #eddac2; }
.closing-cta h2 { margin: 15px 0 30px; font-family: var(--serif); font-size: clamp(44px, 5vw, 70px); font-weight: 400; line-height: 1; }

.site-footer { padding: 70px 5vw 30px; background: #21120d; color: #f9eddd; }
.footer-story { padding-bottom: 50px; display: flex; align-items: center; gap: 18px; border-bottom: 1px solid rgba(255,255,255,.15); }
.footer-story img { width: 70px; padding: 6px; border-radius: 50%; background: #fff5e4; }
.footer-story strong { font-family: var(--serif); font-size: 36px; letter-spacing: .15em; }
.footer-story p { margin: 3px 0 0; color: rgba(255,255,255,.55); }
.footer-grid { padding: 58px 0; display: grid; grid-template-columns: .8fr .8fr .8fr 1.6fr; gap: 45px; }
.footer-grid > div { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }
.footer-grid h3 { margin: 0 0 11px; color: #f2b28f; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
.footer-grid a { color: rgba(255,255,255,.72); font-size: 12px; }
.newsletter p { margin: 0 0 7px; color: rgba(255,255,255,.55); }
.newsletter form { width: 100%; display: grid; grid-template-columns: 1fr auto; }
.newsletter input { min-width: 0; padding: 14px 12px; border: 1px solid rgba(255,255,255,.24); background: transparent; color: white; }
.newsletter button { padding: 0 19px; border: 0; background: var(--coral); color: white; font-weight: 800; cursor: pointer; }
.footer-bottom { padding-top: 25px; display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.45); font-size: 10px; }

.drawer-scrim { position: fixed; inset: 0; z-index: 80; display: block; border: 0; background: rgba(25,13,8,.45); opacity: 0; pointer-events: none; transition: opacity .25s; }
.drawer-scrim.is-open { opacity: 1; pointer-events: auto; }
.cart-drawer { position: fixed; z-index: 90; top: 0; right: 0; width: min(450px, 100vw); height: 100dvh; display: flex; flex-direction: column; background: var(--ivory); transform: translateX(100%); transition: transform .3s cubic-bezier(.2,.8,.2,1); }
.cart-drawer.is-open { transform: translateX(0); }
.drawer-head { padding: 24px 26px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.drawer-head h2 { margin: 4px 0 0; font-family: var(--serif); font-size: 34px; font-weight: 400; }
.icon-button { width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer; font-size: 22px; }
.drawer-lines { flex: 1; padding: 10px 26px; overflow: auto; }
.drawer-line { padding: 18px 0; display: grid; grid-template-columns: 100px 1fr; gap: 15px; border-bottom: 1px solid var(--line); }
.drawer-line img { width: 100px; height: 110px; object-fit: cover; background: var(--cream); }
.drawer-line > div { display: flex; flex-direction: column; align-items: flex-start; }
.drawer-line a { font-family: var(--serif); font-size: 17px; line-height: 1.2; }
.drawer-line span { color: var(--muted); font-size: 10px; }.drawer-line strong { margin-top: 7px; font-size: 12px; }
.line-controls { margin-top: auto; display: flex; align-items: center; gap: 10px; }
.line-controls button { width: 26px; height: 26px; border: 1px solid var(--line); background: transparent; cursor: pointer; }
.line-controls .remove-line { width: auto; margin-left: 4px; border: 0; text-decoration: underline; font-size: 9px; }
.drawer-summary { padding: 22px 26px 28px; border-top: 1px solid var(--line); background: #fffdf8; }
.drawer-summary > div { display: flex; justify-content: space-between; font-family: var(--serif); font-size: 22px; }
.drawer-summary p { color: var(--muted); font-size: 10px; }.drawer-summary .button { margin-top: 8px; }
.empty-state { text-align: center; }.empty-state.compact { padding: 80px 20px; }
.empty-mark { width: 74px; height: 74px; margin: 0 auto 20px; display: grid; place-items: center; border-radius: 50%; background: var(--cream); color: var(--coral); font-family: var(--serif); font-size: 36px; }
.empty-state h3 { font-family: var(--serif); font-size: 25px; font-weight: 400; }

.page-hero { padding: 95px 6vw 80px; background: #eedcc5; text-align: center; }
.page-hero.small { padding-block: 70px 60px; }
.page-hero h1 { max-width: 970px; margin: 15px auto 18px; font-family: var(--serif); font-size: clamp(53px, 6vw, 86px); font-weight: 400; line-height: .98; letter-spacing: -.045em; }
.page-hero p { max-width: 690px; margin: auto; color: var(--brown); }
.catalogue-layout { max-width: 1540px; margin: auto; padding: 75px 4vw 120px; display: grid; grid-template-columns: 230px 1fr; gap: 45px; }
.catalogue-sidebar { position: sticky; top: 120px; height: fit-content; display: flex; flex-direction: column; }
.catalogue-sidebar h2 { margin: 0 0 15px; font-family: var(--serif); font-size: 27px; font-weight: 400; }
.catalogue-sidebar a { padding: 10px 0; display: flex; justify-content: space-between; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11px; }
.catalogue-sidebar a.active { color: var(--coral); font-weight: 800; }
.catalogue-bar { min-height: 56px; margin-bottom: 28px; padding-bottom: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11px; }
.catalogue-bar form { display: flex; align-items: center; gap: 9px; }.catalogue-bar label { display: flex; align-items: center; gap: 8px; }.catalogue-bar select { padding: 8px 28px 8px 10px; border: 1px solid var(--line); background: white; }.catalogue-bar button { padding: 8px 13px; border: 0; background: var(--espresso); color: white; }
.catalogue-empty { padding: 95px 30px; border: 1px solid var(--line); background: #fffdf8; }.catalogue-empty h2 { font-family: var(--serif); font-size: 35px; font-weight: 400; }.catalogue-empty p { color: var(--muted); }.catalogue-empty .button { margin-top: 18px; }
.collection-hero { min-height: 380px; padding: 70px 8vw; display: grid; grid-template-columns: .55fr 1.45fr; align-items: center; gap: 60px; background: #ead7c0; overflow: hidden; }
.collection-hero > span { color: rgba(41,25,18,.16); font-family: var(--serif); font-size: clamp(150px, 22vw, 330px); line-height: .7; }
.collection-hero h1 { margin: 10px 0; font-family: var(--serif); font-size: clamp(60px, 7vw, 100px); font-weight: 400; line-height: 1; }.collection-hero p { max-width: 650px; color: var(--brown); }.collection-hero.coral{background:#efd1c5}.collection-hero.ink{background:#cad0d0}.collection-hero.ember{background:#e7c4b5}.collection-hero.sage{background:#d9decf}.collection-hero.rose{background:#ecd6d7}.collection-hero.amber{background:#efddbd}.collection-hero.sky{background:#d7e4e7}
.subcategory-pills { max-width: 760px; margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px; }
.subcategory-pills span { padding: 8px 11px; border: 1px solid rgba(41,25,18,.18); border-radius: 999px; background: rgba(255,255,255,.32); color: var(--brown); font-size: 9px; font-weight: 700; letter-spacing: .035em; }
.breadcrumbs { max-width: 1540px; margin: auto; padding: 23px 4vw; display: flex; gap: 9px; color: var(--muted); font-size: 10px; }.breadcrumbs b { color: var(--espresso); font-weight: 600; }
.product-detail { max-width: 1540px; margin: auto; padding: 20px 4vw 95px; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(420px, .88fr); gap: 6vw; }
.product-gallery { display: grid; grid-template-columns: 82px 1fr; gap: 13px; align-items: start; }.product-main-image { position: relative; grid-column: 2; grid-row: 1; aspect-ratio: 1; overflow:hidden; background: var(--cream); touch-action:pan-y; }.product-main-image img,.product-main-image video { width: 100%; height: 100%; object-fit: cover; }.product-main-image video { background:#160f0c; }.product-main-image > span { position: absolute; left: 16px; top: 16px; padding: 8px 11px; background: var(--espresso); color: white; font-size: 9px; font-weight: 800; text-transform: uppercase; }.gallery-arrow { position:absolute; z-index:2; top:50%; width:44px; height:44px; display:grid; place-items:center; transform:translateY(-50%); border:1px solid rgba(255,255,255,.8); border-radius:50%; background:rgba(31,17,12,.72); color:white; font-family:var(--serif); font-size:31px; line-height:1; cursor:pointer; backdrop-filter:blur(8px); transition:background .2s,transform .2s; }.gallery-arrow:hover { background:var(--coral); transform:translateY(-50%) scale(1.04); }.gallery-previous { left:16px; }.gallery-next { right:16px; }.gallery-count { position:absolute; right:16px; bottom:16px; padding:7px 10px; border-radius:20px; background:rgba(31,17,12,.74); color:white; font-size:9px; letter-spacing:.08em; backdrop-filter:blur(8px); }
