/* Readable commerce typography
   A 16px customer-facing baseline keeps product, checkout and support content
   comfortable on small screens while retaining Renova's editorial hierarchy. */
:root {
  --text-caption: .8125rem;
  --text-small: .875rem;
  --text-body: 1rem;
  --text-lead: 1.125rem;
}

body { font-size: 17px; line-height: 1.6; }
p, li, dd { text-wrap: pretty; }
.button { min-height: 50px; font-size: var(--text-small); }
.eyebrow, .text-link { font-size: var(--text-caption); }
.site-header nav { font-size: var(--text-small); }
.brand-lockup small, .header-action span { font-size: 11px; }
.search-bar input, .search-bar button { font-size: var(--text-body); }
.trust-row strong { font-size: var(--text-small); }
.trust-row small { font-size: var(--text-caption); }
.category-tile p { font-size: var(--text-small); line-height: 1.5; }
.product-badge, .discount-badge, .product-category { font-size: var(--text-caption); }
.product-card h3 { min-height: 48px; font-size: 21px; line-height: 1.25; }
.rating span, .stars { font-size: var(--text-small); }
.rating small, .rating.unrated span { font-size: var(--text-caption); }
.price-row strong { font-size: 21px; }
.price-row s { font-size: var(--text-small); }
.quick-add { min-height: 46px; font-size: var(--text-caption); }
.review-grid footer b, .footer-grid a { font-size: var(--text-small); }
.review-grid footer span, .footer-grid h3, .footer-bottom { font-size: var(--text-caption); }
.footer-story p, .newsletter p { font-size: var(--text-body); line-height: 1.6; }
.newsletter input, .newsletter button { font-size: var(--text-body); }
.drawer-line a { font-size: 19px; }
.drawer-line span, .drawer-summary p { font-size: var(--text-small); }
.drawer-line strong { font-size: var(--text-body); }
.line-controls .remove-line { font-size: var(--text-caption); }
.page-hero p, .collection-hero p, .motion-copy > p, .collection-motion-copy > p { font-size: var(--text-body); line-height: 1.65; }
.catalogue-sidebar a, .catalogue-bar, .breadcrumbs { font-size: var(--text-small); }
.subcategory-pills span, .catalogue-filters label, .shopper-tools button, .shopper-tools a { font-size: var(--text-caption); }
.search-suggestions a { font-size: var(--text-small); }
.search-suggestions b { font-size: var(--text-caption); }
.product-rating a, .stock-line, .field-head, .quantity-block label { font-size: var(--text-small); }
.detail-price strong { font-size: 30px; }
.detail-price span { font-size: var(--text-caption); }
.customer-review-form p, .customer-review-form label { font-size: var(--text-small); }
.customer-review-form input, .customer-review-form select, .customer-review-form textarea,
.variant-pills button, .quantity-block input, .quantity-block button { font-size: var(--text-body); }
.purchase-trust, .product-accordions summary { font-size: var(--text-small); }
.product-accordions p, .product-highlights p, .spec-notes p { font-size: var(--text-body); line-height: 1.65; }
.product-specifications dt { font-size: var(--text-caption); }
.cart-page-lines p, .cart-totals p, .remove-link { font-size: var(--text-small); }
.checkout-header > b, .checkout-header > a:last-child,
.checkout-progress span { font-size: var(--text-small); }
.checkout-form-area label, .checkout-fieldset label,
.delivery-options label, .checkout-summary p, .checkout-summary small { font-size: var(--text-small); }
.checkout-form-area input, .checkout-form-area select, .checkout-form-area textarea { font-size: var(--text-body); line-height: 1.45; }
.assistant-panel header small { font-size: var(--text-caption); }
.assistant-messages p { font-size: var(--text-small); line-height: 1.55; }
.assistant-suggestions button { font-size: var(--text-caption); }
.assistant-panel form input, .assistant-panel form button { font-size: var(--text-body); }
.assistant-panel footer { font-size: 12px; }
.saved-grid h3 { font-size: 18px; }
.saved-grid a, .comparison-table dl div { font-size: var(--text-caption); }
.motion-note, .collection-pulse, .motion-card figcaption { font-size: var(--text-caption); }

@media (max-width: 760px) {
  body { font-size: 16px; line-height: 1.6; }
  .test-ribbon { min-height: 32px; font-size: 10px; }
  .hero-copy > p { font-size: var(--text-body); line-height: 1.65; }
  .trust-row strong { font-size: var(--text-caption); }
  .trust-row small { font-size: 12px; }
  .category-tile h3 { font-size: 23px; }
  .category-tile p { font-size: var(--text-caption); }
  .product-card h3 { min-height: 50px; font-size: 18px; line-height: 1.3; }
  .product-category { font-size: 12px; }
  .price-row { flex-direction: row; flex-wrap: wrap; gap: 4px 8px; }
  .price-row strong { font-size: 19px; }
  .quick-add { font-size: var(--text-caption); }
  .footer-story p, .footer-grid a { font-size: var(--text-small); }
  .catalogue-sidebar a, .catalogue-bar { font-size: var(--text-caption); }
  .motion-copy > p, .collection-motion-copy > p { font-size: var(--text-body); }
  .motion-note, .collection-pulse { font-size: 12px; line-height: 1.5; }
  .checkout-progress span { font-size: 0; }
  .checkout-form-area label, .checkout-fieldset label,
  .delivery-options label, .checkout-summary p, .checkout-summary small { font-size: var(--text-small); }
  .assistant-messages p { font-size: var(--text-small); }
}

@media (max-width: 390px) {
  .product-card h3 { font-size: 17px; }
}

/* Catalogue navigation, purchase confidence and privacy controls */
.categories-trigger { padding: 8px 2px; display: inline-flex; align-items: center; gap: 7px; border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--espresso); font: inherit; font-weight: 750; cursor: pointer; }
.categories-trigger:hover,.categories-trigger[aria-expanded="true"] { border-bottom-color: var(--coral); color: var(--coral); }
.mega-menu { position: absolute; z-index: 30; top: 100%; left: 0; right: 0; max-height: min(75vh,760px); padding: 30px max(4vw,32px) 38px; overflow: auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fffaf2; box-shadow: 0 28px 60px rgba(41,25,18,.16); }
.mega-menu-head { margin-bottom: 25px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
.mega-menu-head h2 { margin: 5px 0 0; font-family: var(--serif); font-size: clamp(28px,3vw,42px); font-weight: 400; line-height: 1; }
.mega-menu-head > a { color: var(--coral); font-size: var(--text-small); font-weight: 800; }
.mega-menu-grid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 28px 24px; }
.mega-menu-grid section { min-width: 0; }
.mega-category { display: block; padding-bottom: 8px; border-bottom: 1px solid var(--line); color: var(--espresso); font-family: var(--serif); font-size: 20px; line-height: 1.15; }
.mega-menu-grid section > div { padding-top: 8px; display: flex; flex-direction: column; gap: 5px; }
.mega-menu-grid section > div a { color: var(--muted); font-size: var(--text-caption); line-height: 1.35; }
.mega-menu-grid a:hover { color: var(--coral); }
.search-suggestions a { grid-template-columns: 46px minmax(0,1fr) auto; }
.search-suggestions a > span { min-width: 0; display: flex; flex-direction: column; }
.search-suggestions a small { color: var(--muted); font-size: 12px; }
.search-suggestions a > strong { color: var(--coral); font-size: var(--text-caption); white-space: nowrap; }
.subcategory-chips { margin: -4px 0 28px; display: flex; flex-wrap: wrap; gap: 8px; }
.subcategory-chips a { padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: #fffdf8; color: var(--brown); font-size: var(--text-caption); }
.subcategory-chips a:hover { border-color: var(--coral); color: var(--coral); }

.product-delivery-card { margin: 22px 0; border: 1px solid var(--line); background: #fffdf8; }
.product-delivery-card > div { padding: 14px 15px; display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; border-bottom: 1px solid var(--line); }
.product-delivery-card > div:last-child { border-bottom: 0; }
.product-delivery-card > div > span { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; background: #f5d7cd; color: var(--coral); font-weight: 900; }
.product-delivery-card p { margin: 0; display: flex; flex-direction: column; line-height: 1.35; }
.product-delivery-card b { font-size: var(--text-small); }
.product-delivery-card small { margin-top: 3px; color: var(--muted); font-size: var(--text-caption); line-height: 1.45; }
.product-delivery-card a,.question-grid a { color: var(--coral); text-decoration: underline; }
.product-questions { padding-top: 35px; }
.question-grid { border-top: 1px solid var(--line); }
.question-grid details { border-bottom: 1px solid var(--line); }
.question-grid summary { padding: 20px 4px; display: flex; justify-content: space-between; gap: 20px; cursor: pointer; font-family: var(--serif); font-size: clamp(20px,2vw,27px); list-style: none; }
.question-grid summary::-webkit-details-marker { display: none; }
.question-grid summary span { color: var(--coral); }
.question-grid p { max-width: 850px; margin: -4px 0 22px; color: var(--brown); }

.consent-banner { position: fixed; z-index: 100; left: 24px; right: 24px; bottom: 24px; max-width: 1180px; margin: auto; padding: 25px; display: grid; grid-template-columns: minmax(0,1.25fr) minmax(320px,.75fr); gap: 20px 30px; border: 1px solid rgba(255,255,255,.14); background: var(--espresso); color: white; box-shadow: 0 28px 85px rgba(30,16,11,.35); }
.consent-copy h2 { margin: 6px 0 9px; color: white; font-family: var(--serif); font-size: clamp(28px,3vw,42px); font-weight: 400; line-height: 1; }
.consent-copy p { margin: 0; color: rgba(255,255,255,.72); font-size: var(--text-small); line-height: 1.55; }
.consent-copy a { color: #ffc1a9; text-decoration: underline; }
.consent-options { grid-column: 1/-1; display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.consent-options label { padding: 13px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid rgba(255,255,255,.17); background: rgba(255,255,255,.05); }
.consent-options label span { display: flex; flex-direction: column; }
.consent-options small { margin-top: 3px; color: rgba(255,255,255,.55); font-size: 12px; line-height: 1.35; }
.consent-options input { width: 18px; height: 18px; accent-color: var(--coral); }
.consent-actions { align-self: end; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
.consent-actions .button { flex: 1 1 120px; padding-inline: 14px; }
.consent-actions .quiet { border-color: rgba(255,255,255,.34); color: white; }
.footer-privacy-button { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
.footer-privacy-button:hover { color: var(--coral); }

@media (max-width: 1180px) {
  .mega-menu-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
}
@media (max-width: 820px) {
  .mega-menu { position: fixed; top: 78px; padding: 24px 20px 100px; }
  .mega-menu-head { align-items: start; }
  .mega-menu-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .consent-banner { left: 12px; right: 12px; bottom: 12px; padding: 20px; grid-template-columns: 1fr; }
  .consent-options { grid-template-columns: 1fr; }
  .consent-actions { justify-content: stretch; }
}
@media (max-width: 520px) {
  .mega-menu-head { flex-direction: column; }
  .mega-menu-grid { grid-template-columns: 1fr; }
  .consent-actions { flex-direction: column; }
  .consent-actions .button { flex-basis: auto; width: 100%; }
  .product-delivery-card > div { padding-inline: 12px; }
}

/* Renova white commerce system
   Product-led pages use clean neutral surfaces while brand moments retain the
   phoenix palette. Hero, animated collections, promotions, CTAs and footer are
   intentionally unchanged. */
:root {
  --commerce-white: #ffffff;
  --commerce-soft: #fff9f2;
  --commerce-image: #f7f5f2;
  --commerce-text: #281710;
  --commerce-muted: #6f625c;
  --commerce-line: #e8e2dc;
}

html, body { background: var(--commerce-white); color: var(--commerce-text); }
.site-header { background: rgba(255,255,255,.96); border-bottom-color: var(--commerce-line); }
.search-shell,.search-bar,.search-suggestions { background: var(--commerce-white); }

/* Shopping and discovery */
.product-section,.catalogue-layout,.catalogue-main,.saved-collections,
.product-detail,.product-reviews,.product-questions,.related-products,
.cart-page,.policy-page,.story-page { background: var(--commerce-white); }
.product-card,.product-card-body { background: var(--commerce-white); }
.product-image-wrap,.product-main-image,.gallery-thumbs button,
.cart-page-lines img,.saved-grid img,.comparison-table img { background: var(--commerce-image); }
.catalogue-sidebar,.catalogue-filters,.catalogue-bar { background: var(--commerce-white); }
.catalogue-sidebar a,.catalogue-bar,.breadcrumbs,.product-category,
.rating small,.price-row s { color: var(--commerce-muted); }
.catalogue-empty,.customer-review-form,.product-delivery-card,
.saved-grid article,.comparison-table article,.question-grid details,
.cart-totals { background: var(--commerce-white); border-color: var(--commerce-line); }
.subcategory-chips a { background: var(--commerce-white); border-color: var(--commerce-line); }
.purchase-trust,.empty-mark,.success-facts span { background: var(--commerce-soft); }

/* Cart, checkout and order completion */
.checkout-shell { background: var(--commerce-soft); }
.checkout-header,.checkout-form-area,.checkout-fieldset,.delivery-options label,
.review-block,.checkout-empty,.order-result,.admin-access { background: var(--commerce-white); }
.checkout-header,.checkout-fieldset,.delivery-options label,.review-block,
.checkout-form-area input,.checkout-form-area select,.checkout-form-area textarea {
  border-color: var(--commerce-line);
}
.checkout-fieldset { box-shadow: none; }
.checkout-form-area { box-shadow: 0 18px 50px rgba(40,23,16,.055); }

/* Policies and support information */
.page-hero { background: var(--commerce-soft); }
.policy-page { max-width: 940px; }
.policy-contact { background: var(--commerce-soft); border: 1px solid var(--commerce-line); }
.tracking-intro { background: var(--commerce-soft); }
.tracking-result,.tracking-art { background: var(--commerce-white); }

/* Owner workspace: neutral working canvas, white forms */
.admin-shell { background: var(--commerce-image); }
.admin-panel,.admin-metrics article,.product-form,.review-form,
.review-form header,.review-form footer,.admin-review-list article,
.catalogue-tools input,.catalogue-tools select,
.product-form input,.product-form select,.product-form textarea,
.review-form input,.review-form select,.review-form textarea {
  background: var(--commerce-white);
}
.table-heading { background: var(--commerce-soft); }

/* Keep warmth as accents rather than page-wide colour */
.mega-menu { background: var(--commerce-soft); }
.assistant-panel,.assistant-fields { background: var(--commerce-white) !important; }
.assistant-messages .assistant,.assistant-panel footer { background: var(--commerce-soft); }

@media (max-width: 760px) {
  .site-header nav { background: var(--commerce-white); }
  .catalogue-sidebar { padding: 14px; border: 1px solid var(--commerce-line); }
  .checkout-shell { background: var(--commerce-white); }
  .checkout-form-area { box-shadow: none; }
}

/* Renova trust-blue + phoenix-orange identity
   Blue guides and reassures. Orange invites action. Green confirms success. */
:root {
  --trust-blue: #146ef5;
  --trust-blue-hover: #0f5fd8;
  --trust-blue-dark: #0b347a;
  --trust-blue-soft: #edf5ff;
  --phoenix-orange: #f05a2a;
  --phoenix-orange-hover: #d9471c;
  --success-green: #158a55;
  --error-red: #d92d20;
  --commerce-text: #172033;
  --commerce-muted: #667085;
  --commerce-line: #e4e7ec;
}

body { color: var(--commerce-text); }
.site-header { color: var(--commerce-text); }
.brand-lockup strong { color: var(--trust-blue-dark); }
.brand-lockup small { color: var(--commerce-muted); }

/* Trust, navigation and discovery */
.site-header nav a:hover,.categories-trigger:hover,
.categories-trigger[aria-expanded="true"],.mega-menu-grid a:hover,
.text-link,.catalogue-sidebar a.active,.search-suggestions a > strong,
.breadcrumbs a:hover,.subcategory-chips a:hover,.saved-grid a,
.product-rating a,.product-delivery-card a,.question-grid a,
.policy-page a,.tracking-result a,.footer-privacy-button:hover {
  color: var(--trust-blue);
}
.site-header nav a::after { background: var(--trust-blue); }
.categories-trigger:hover,.categories-trigger[aria-expanded="true"],
.subcategory-chips a:hover { border-color: var(--trust-blue); }
.catalogue-sidebar a.active { border-bottom-color: var(--trust-blue); }
.trust-row b { color: var(--trust-blue); }
.product-delivery-card > div > span {
  background: var(--trust-blue-soft);
  color: var(--trust-blue);
}
.checkout-progress span.active b,.fieldset-index {
  background: var(--trust-blue);
  border-color: var(--trust-blue);
}
.checkout-progress span.active { color: var(--trust-blue-dark); }
.checkout-form-area input:focus,.checkout-form-area select:focus,
.checkout-form-area textarea:focus {
  border-color: var(--trust-blue);
  box-shadow: 0 0 0 3px rgba(20,110,245,.11);
}
.tracking-timeline article.done i { background: var(--trust-blue); border-color: var(--trust-blue); }
.tracking-result header > b { background: var(--trust-blue-soft); color: var(--trust-blue-dark); }
.consent-options input { accent-color: var(--trust-blue); }

/* Phoenix orange is reserved for shopping actions and promotion */
.button.primary,.quick-add:hover,.assistant-launcher,
.assistant-panel form button,.catalogue-filters button,
.discount-badge,.delivery-options label i {
  background: var(--phoenix-orange);
  color: #fff;
}
.button.primary:hover,.assistant-launcher:hover,
.assistant-panel form button:hover,.catalogue-filters button:hover {
  background: var(--phoenix-orange-hover);
}
.quick-add { color: var(--commerce-text); }
.quick-add span,.product-badge + .discount-badge,
.detail-price span,.hero-note strong { color: var(--phoenix-orange); }
.quick-add:hover { padding-inline: 12px; }
.delivery-options label.selected {
  border-color: var(--phoenix-orange);
  box-shadow: 0 0 0 1px var(--phoenix-orange);
}
.product-badge { background: var(--trust-blue-dark); }
.discount-badge { color: white; }

/* Calm blue supporting surfaces */
.mega-menu,.checkout-shell,.tracking-intro { background: var(--trust-blue-soft); }
.subcategory-chips a:hover,.catalogue-sidebar a.active {
  background: var(--trust-blue-soft);
}
.checkout-assurance { border: 1px solid rgba(255,255,255,.12); }
.checkout-summary { background: var(--trust-blue-dark); }
.checkout-assurance b { color: #b9d4ff; }
.consent-banner,.assistant-panel header { background: var(--trust-blue-dark); }

/* Semantic colours stay predictable */
.in-stock,.status-dot,.table-row i.published { background-color: var(--success-green); }
.track-error,.integration-notice.error { color: var(--error-red); }
.table-row i.draft { background: #f2f4f7; color: var(--commerce-muted); }

/* Preserve the phoenix story in editorial brand moments */
.hero .eyebrow,.editorial-banner .eyebrow,.closing-cta .eyebrow,
.category-number,.product-badge,.consent-banner .eyebrow {
  color: inherit;
}
.hero .eyebrow,.editorial-banner .eyebrow,.closing-cta .eyebrow {
  color: #ffc7ad;
}

@media (max-width: 760px) {
  .mega-menu { background: var(--trust-blue-soft); }
  .site-header nav { border-bottom-color: var(--commerce-line); }
}
