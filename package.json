{
  "name": "renova-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev --hostname 0.0.0.0 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-10000}",
    "test": "npm run test:whatsapp && npm run test:migration && npm run verify:cumulative && npm run build && npm run test:production",
    "test:whatsapp": "node scripts/test-whatsapp.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "verify:ai-listing": "node scripts/verify-ai-product-assistant.mjs",
    "verify:admin": "node scripts/verify-admin-workspace.mjs",
    "verify:cumulative": "node scripts/verify-cumulative-source.mjs && node scripts/verify-ai-product-assistant.mjs && node scripts/verify-admin-workspace.mjs",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:worker": "bash scripts/build-verified.sh",
    "test:migration": "node scripts/test-aiven-migration.mjs",
    "test:production": "node --test tests/anagen-rendered.test.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.25",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "ng-geo-data": "^1.0.0",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Renova Store"
}
